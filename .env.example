# Google Trends API Keys
# These should be set in Netlify environment variables
# DO NOT commit actual keys to the repository

# SerpApi - For Google Trends data
# Get your key at: https://serpapi.com
# Free tier: 250 searches/month
SERPAPI_API_KEY=your_serpapi_key_here

# NewsAPI - Fallback for trending news
# Get your key at: https://newsapi.org
# Free tier: 100 requests/day
NEWSAPI_KEY=your_newsapi_key_here

# Note: These environment variables are used by the Netlify serverless function
# at netlify/functions/trends.js
#
# To set in Netlify:
# 1. Go to Site settings → Environment variables
# 2. Add each variable with your actual API keys
# 3. Redeploy your site
